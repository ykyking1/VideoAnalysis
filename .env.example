# Kopyalayip .env yapin. Uretimde parolalari MUTLAKA degistirin.

# --- Nesne deposu (MinIO) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_SECURE=false
MINIO_BUCKET_RAW=raw-videos
MINIO_BUCKET_PROXY=proxy-videos

# --- Vektor deposu (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=true
QDRANT_COLLECTION=clips
# QDRANT_API_KEY=
# Uretim olceginde (~540M vektor) vektorler RAM'e sigmaz:
QDRANT_ON_DISK=true
QDRANT_QUANTIZATION=scalar      # none | scalar (int8, 4x kucultur)
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=128
QDRANT_SEARCH_HNSW_EF=128

# --- Embedding modeli (proje-ozeti.md §5) ---
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
# EMBEDDING_MODEL_DIR=/path/to/local/copy   # HF Hub yerine yerel kopya
EMBEDDING_DIM=2048              # MRL: 64-2048 arasi kisaltilabilir
EMBEDDING_NUM_FRAMES=8
EMBEDDING_BATCH_SIZE=8          # GPU VRAM'ine gore ayarlayin
EMBEDDING_DTYPE=auto            # auto | float16 | bfloat16
                                # auto: Ampere+ (cc>=8.0) bf16, oncesi fp16.
                                # Turing'de (T4) bf16 ~10x yavas - olculdu.

# --- Pencereleme (proje-ozeti.md §3.1 madde 2) ---
# SINIRLI KANIT (N=10, yapay birlestirilmis video) - kisa/ani olaylarda
# davranisi test edilmedi. Detay: common/config.py, docs/worklog_2026-08-01.md
WINDOW_S=60.0
STRIDE_S=60.0                   # =WINDOW_S: ortusmesiz.

# --- Proxy uretimi ---
PROXY_HEIGHT=360
PROXY_BITRATE=800k
PROXY_USE_NVDEC=true
PROXY_USE_NVENC=true

# --- Gorsel alanlar (YOLO26) ---
YOLO_MODEL=yolo26s.pt           # olcumle secildi (bkz. common/config.py) - kendi IR fine-tune agirliginizla degistirin
YOLO_SAMPLE_FRAMES=3
YOLO_CONF=0.25

# --- vLLM (sorgu ayristirma + caption + rerank) ---
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
PARSE_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
VLM_BASE_URL=http://localhost:8000/v1
VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
LLM_TIMEOUT_S=120

# --- Caption (proje-ozeti.md §3.1 madde 5) ---
CAPTION_ENABLED=true
CAPTION_WINDOW_FRACTION=0.10

# --- Sorgu hatti ---
SEARCH_TOP_K=20
SEARCH_MIN_RESULTS=5            # bu sayinin altina duserse filtre gevsetilir
INTERVAL_GAP_TOLERANCE_S=10.0
RERANK_ENABLED=false            # VLM rerank - gecikmeyi ciddi artirir
RERANK_CANDIDATES=10

# --- Kafka / Temporal ---
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=video-ingest
KAFKA_GROUP_ID=video-ingest-workers
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=video-ingest
MAX_CONCURRENT_ACTIVITIES=1     # tek GPU'lu worker'da 1 birakin (VRAM)
PARALLEL_GPU_ACTIVITIES=false   # ayri GPU havuzlariniz varsa true

# --- Durum takibi (Postgres) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=videoanalysis

# --- Telemetri ---
# TELEMETRY_OFFSET_S=0.0        # video/telemetri zaman kaymasi
# COASTLINE_GEOJSON=/path/to/land_polygons.geojson   # over_sea hesabi icin
